"jumpNo": -1,
"command": "",
"showArrow": false,
"prohibited": false,
"text": {
"en": "You can zoom in and out on the map. \nGive it a try.",
"ja_JP": "マップは拡大縮小が可能です。\n実際にやってみましょう。",
"zh_CN": "你可以放大或缩小地图。 \n试一试吧。"
}
